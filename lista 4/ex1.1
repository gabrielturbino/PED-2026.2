#include <stdio.h>
#include <stdlib.h> //lembrar da biblioteca para ponteiro

int  main()
{
   int *ptr, i;
   ptr = (int *) calloc(10, sizeof(int)); //10 espaços para inteiros 
   *ptr = 10; //o primeiro valor para qual o ponteiro aponta vira 10
   for(i=0;i<5;i++){ //enquanto o i for menor que 5 ele roda, então de 0 a 4 roda 5 vezes
      *ptr=*ptr+1; //11 --- 12 --- 13 --- 15 --- 15
   }
   printf("\nptr: %d", *ptr);
   return 0;
}


